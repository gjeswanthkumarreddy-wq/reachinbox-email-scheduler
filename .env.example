# ─────────────────────────────────────────────────────────────────────────────
# ReachInbox Email Scheduler — Environment Variables
#
# Copy this file to `.env` and fill in every value before running the app.
#   cp .env.example .env
#
# NEVER commit `.env` to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development

# Port for the Express API server
API_PORT=3001

# Port for the Next.js frontend (used by Next internally, referenced by API CORS)
FRONTEND_URL=http://localhost:3000

# Number of concurrent BullMQ job processors per worker instance.
# Increase to handle more simultaneous emails (balance against SMTP limits).
WORKER_CONCURRENCY=5


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Matches the docker-compose.yml defaults. Change only if you modified them.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox


# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by BullMQ (job storage), express-session (session store), and the
# rate-limit Lua script. AOF persistence must be enabled (see docker-compose).
REDIS_URL=redis://localhost:6379


# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# Name of the Elasticsearch index for email job documents.
ELASTICSEARCH_INDEX=email_jobs


# ── Session ───────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a cryptographically random string of >=32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Session lifetime in seconds (default: 24 hours)
SESSION_TTL_SECONDS=86400


# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Obtain from Google Cloud Console -> APIs & Services -> Credentials.
# Authorised redirect URI must include: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback


# ── Slack OAuth 2.0 ───────────────────────────────────────────────────────────
# Obtain from api.slack.com -> Your Apps -> OAuth & Permissions.
# Required scopes: chat:write, incoming-webhook
# Redirect URL must include: http://localhost:3001/api/slack/callback
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_CALLBACK_URL=http://localhost:3001/api/slack/callback


# ── BullMQ Board (Admin UI) ───────────────────────────────────────────────────
# Basic-auth credentials for the queue monitoring dashboard at /admin/queues
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=changeme


# ── Ethereal SMTP ─────────────────────────────────────────────────────────────
# Ethereal is a fake SMTP service for testing — emails are NOT delivered.
# Leave blank to auto-create a one-time test account via nodemailer on startup.
# Or pre-fill with credentials from https://ethereal.email to reuse an account.
ETHEREAL_USER=
ETHEREAL_PASS=
